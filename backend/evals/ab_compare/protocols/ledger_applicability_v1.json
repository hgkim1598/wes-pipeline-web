    {"id": "understanding", "label": "이해도 (사람, 1–5)", "auto": null, "human": "score", "better": "higher"},
    {"id": "usefulness", "label": "점검 방법 유용성 (사람, 1–5)", "auto": null, "human": "score", "better": "higher"}
  ],
  "successCriteria": [
    {"id": "S1", "metric": "nonRunClaims", "rule": "B_total == 0", "source": "human", "label": "With 경로의 사람 확인 미실행 단계 결과 주장 0건 (1차 지표)"},
    {"id": "S2", "metric": "execContradictions", "rule": "B_total == 0", "source": "human", "label": "With 경로의 실행 상태 모순 0건"},
    {"id": "S3", "metric": "supportedClaims", "rule": "B_rate >= A_rate - 0.05", "source": "human", "label": "근거 일치율이 Without보다 5%p 넘게 낮지 않음"},
    {"id": "S4", "metric": "wrongCauses", "rule": "B_total <= A_total", "source": "human", "label": "근거 없는 원인 단정이 늘지 않음"},
    {"id": "S5", "metric": "requiredCauses", "rule": "B_total >= A_total", "source": "human", "label": "필수 원인 언급이 줄지 않음 (보류로 정보가 빠지는지 확인)"},
    {"id": "S6", "metric": "understanding", "rule": "B_median >= A_median - 0.5", "source": "human", "label": "이해도 중앙값이 0.5점 넘게 낮지 않음"},
    {"id": "S7", "metric": "usefulness", "rule": "B_median >= A_median - 0.5", "source": "human", "label": "점검 유용성 중앙값이 0.5점 넘게 낮지 않음"},
    {"id": "S8", "metric": "gateRejected", "rule": "B_total <= A_total", "source": "auto", "label": "Gate 거부가 늘지 않음"},
    {"id": "S9", "metric": "latency", "rule": "B_median < A_median * 1.2", "source": "auto", "label": "응답 시간 중앙값 증가 20% 미만"}
  ]

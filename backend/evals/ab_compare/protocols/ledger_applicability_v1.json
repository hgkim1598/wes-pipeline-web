  "claimUnit": "summary를 제외한 importantFindings · limitations · nextChecks · uncertainties의 statement 하나",
  "detectors": [
    {"id": "NR-FASTQC", "metric": "nonRunClaims", "activeWhenNotRun": ["01_raw_qc"],
     "label": "실행 안 된 FastQC의 결과·동작을 말함",
     "pattern": "FastQC[^.。]*?(생성되|만들어지|만들어졌|그대로 있|계속|still runs|unaffected|remain|영향이 없|영향을 받지|달라지지 않|없다는 뜻은 아닙)"},
    {"id": "NR-CALLING", "metric": "nonRunClaims", "activeWhenNotRun": ["06_variant_calling"],
     "label": "실행 안 된 변이 검출이 진행·정상이라고 말함",
     "pattern": "(variant calling proceeds|변이 (검출|호출)[^.。]*?(진행되었|진행됐|영향받지 않았|영향이 없었|정상적으로 (진행|완료)))"},
    {"id": "NR-RESULT-EXISTS", "metric": "nonRunClaims", "activeWhenNotRun": ["03_alignment", "05_coverage_qc", "06_variant_calling"],
     "label": "실행 안 된 단계의 결과가 있다고 말함",
     "pattern": "(변이 결과|커버리지 결과|정렬 결과|BAM 파일)[^.。]*?(있습니다|확인할 수 있습니다|생성되었|만들어졌)"},
    {"id": "EX-CORE-DONE", "metric": "execContradictions", "activeWhenNotRun": ["03_alignment", "04_processing", "06_variant_calling"],
     "label": "핵심 분석이 끝났다고 말함",
     "pattern": "(core raw VCF and core artifacts are complete|핵심 (분석|산출물)[^.。]*?(끝났|완료되었|완성))"},
    {"id": "EX-RUN-COMPLETED", "metric": "execContradictions", "activeWhenRunFailed": true,
     "label": "실패한 실행을 완료·성공이라고 말함",
     "pattern": "(실행|분석)(은|이)? (정상적으로 |성공적으로 )?(완료되었|끝까지 진행되었|성공했)"}
  ],
  "wrongCauseCandidates": [
    {"id": "WC-GENERIC-RESOURCE", "label": "일반적 리소스 원인을 이 Run의 원인으로 단정",
     "pattern": "(contig|염색체 이름|길이|좌표|known_sites|dbSNP)[^.。]*?(때문에 실패|원인입니다|원인이었|로 인해 실패)"},
    {"id": "WC-MULTIQC-CAUSE", "label": "MultiQC 경고를 실패 원인으로 말함",
     "pattern": "MultiQC[^.。]*?(때문에 (실패|멈)|실패 원인|실패의 원인)"},
    {"id": "WC-INSTALL-FIXES-ALL", "label": "도구 설치로 모든 문제가 해결된다고 단정",
     "pattern": "(설치|PATH)[^.。]*?(모두 해결|전부 해결|모든 문제[^.。]*?해결|BED[^.。]*?해결)"}
  ],
  "metrics": [
    {"id": "nonRunClaims", "label": "실행되지 않은 단계의 결과를 주장한 건수", "auto": "detector", "human": "claim flag", "better": "lower"},
    {"id": "execContradictions", "label": "실행 상태 사실과 모순된 주장 수", "auto": "detector", "human": "claim flag", "better": "lower"},
    {"id": "supportedClaims", "label": "근거가 주장을 뒷받침한 수 / 평가한 주장 수", "auto": null, "human": "claim verdict", "better": "higher"},
    {"id": "requiredCauses", "label": "필수 실패 원인을 올바르게 언급한 수 / 필수 원인 수", "auto": "pattern", "human": "cause checklist", "better": "higher"},
    {"id": "wrongCauses", "label": "근거 없는 원인 단정 수", "auto": "candidate pattern", "human": "claim flag", "better": "lower"},

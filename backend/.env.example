# Copy to backend/.env (git-ignored) and fill in for this machine.
#
# Deploying to a Linux server: docs/DEPLOYMENT.md walks through this file in
# context, and script/server_preflight.sh checks the paths set below actually
# exist before a run is submitted.
#
# Reference-bundle values are supplied by the operator, never by the browser.
# Leave a value blank rather than guessing: main.sh is fail-closed and a wrong
# reference is far worse than a refused run.

# check_only -> main.sh --check-only (preflight only; no analysis tool runs)
# full       -> the whole pipeline. Requires bwa/samtools/gatk/bcftools/tabix/
#               bgzip/mosdepth/fastqc on PATH.
WES_RUN_MODE=check_only

# bash executable. Git Bash on Windows, system bash on Linux.
WES_BASH=bash

# Reference bundle. Every path is read by main.sh, not by the backend.
WES_ASSEMBLY=GRCh38
# Read the FIRST COLUMN of the reference .fai and declare it. Do not guess:
#   contigs named chr1  -> chr
#   contigs named 1     -> plain
WES_CONTIG_STYLE=
WES_BUNDLE_ID=grch38_wes_germline
WES_REFERENCE_FASTA=
# Comma-separated list of BQSR known-sites VCFs.
WES_KNOWN_SITES=
WES_DBSNP_VCF=

# Optional InterVar / ACMG classification (11_intervar).
#
# Set ALL THREE or NONE. All three set -> the UI's "ACMG 자동 분류" option is
# honoured. None set -> the option is reported back as unsupported and the step
# is not planned. A partial setting is refused at startup, because it means the
# operator meant to enable this and got it wrong.
#
# main.sh never installs InterVar or the ANNOVAR humandb; both directories must
# already exist. WES_INTERVAR_BUILD must match the assembly (GRCh38 -> hg38);
# main.sh validates that pair itself and fails the optional step if it is wrong.
WES_INTERVAR_DIR=
WES_INTERVAR_BUILD=
WES_INTERVAR_HUMANDB=

# Compute
WES_THREADS=4
WES_JAVA_MEM_GB=8

# AI synthesis (POST /api/jobs/{id}/synthesis).
#
# No credential belongs in this file. Synthesis shells out to the Claude Code
# CLI and uses whatever subscription login `claude auth login` already
# established on this machine. The backend refuses to run it at all if an
# Anthropic API key is present in the environment, because that would bill API
# credit instead of the subscription.
#
# Model alias or full id. Left at sonnet on purpose: the CLI's own default
# resolves to a larger model, and summarising one run does not need it -- the
# budget here is a subscription allowance. Blank means "whatever the CLI is
# configured to use".
WES_SYNTHESIS_MODEL=sonnet

# Synthesis subprocess timeout, in seconds.
#
# NOT a WES quality threshold -- this project sets no pass/fail thresholds for
# coverage or depth. This bounds one child process so a wedged CLI cannot hold
# a worker thread; it says nothing about the run being explained.
#
# A real full run took 160.7s, so 120 was too low and killed working calls.
# A timed-out call is never retried. The limit applies to each call, so with
# WES_SYNTHESIS_REPAIR=on one request can wait up to twice this long.
WES_SYNTHESIS_TIMEOUT_SECONDS=300

# One rewrite after a safety-gate rejection: on | off (blank = off).
#
# When on, an AI explanation that a runtime gate rejected (shape, unknown
# evidence id, a number the run data does not contain, an internal field
# name) is sent back to the same provider ONCE with what the gate found, and
# the rewrite must pass the same gates. At most two calls per request; a
# provider failure (timeout, login, usage limit) is never retried. A second
# call spends subscription allowance, which is why this is off by default.
# Any other value stops the server at startup. See backend/README.md.
WES_SYNTHESIS_REPAIR=off

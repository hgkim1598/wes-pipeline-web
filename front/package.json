{
  "name": "wes-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "postbuild": "node scripts/check-dist.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "test:scripts": "node --test scripts/check-dist.test.mjs scripts/breakpoints.test.mjs scripts/storage-boundary.test.mjs",
    "test:trace": "node --experimental-strip-types --test scripts/doc-trace-selection.test.mjs",
    "test:placement": "node --experimental-strip-types --test scripts/synthesis-placement.test.mjs",
    "test:docview": "node --experimental-strip-types --test scripts/doc-hit-view.test.mjs",
    "test:workspace": "node --experimental-strip-types --test scripts/workspace-view.test.mjs",
    "test:facts": "node --experimental-strip-types --test scripts/fact-applicability.test.mjs",
    "test:compare": "node --experimental-strip-types --test scripts/eval-compare.test.mjs",
    "test:policy": "node --experimental-strip-types --test scripts/run-detail-policy.test.mjs",
    "test:copy": "node --experimental-strip-types --test scripts/run-detail-copy.test.mjs",
    "test:entry": "node --experimental-strip-types --test scripts/entry-model.test.mjs",
    "typecheck": "tsc -b --force",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@tanstack/react-query": "^5.102.8",
    "lucide-react": "^1.35.0",
    "pretendard": "^1.3.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^7.18.2",
    "sonner": "^2.0.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
